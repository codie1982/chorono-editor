# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache/
.pnpm-lock.yaml

# Testing
/coverage
*.lcov

# Next.js
/.next/
/out/
.next/
dist/

# Production
/build

# Runtime bundle (tsup → copied to chorono-runtime repo for publish)
/dist
/.chorono/
/.mcp.json
/projects/

# Misc
.DS_Store
*.pem
.editorconfig

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Local env files (never commit secrets!)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.DS_Store

# OS
Thumbs.db
*.bak
*.tmp

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Claude Code (session/permissions - local only)
.claude/

# Storybook
storybook-static/

# Turbo
.turbo/

# Generated files
*.generated.ts
*.generated.js

/desing-mockups

# Markdown files (except project guidance, community files, docs and skills)
*.md
!README.md
!CLAUDE.md
!AGENTS.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/.github/PULL_REQUEST_TEMPLATE.md
!/docs/
!/docs/**/*.md
!/skills/
!/skills/**/*.md

# The CLI bundles these from the canonical /skills source at build time.
/packages/cli/skills/
/packages/cli/LICENSE
/.agents/skills/
*.tgz
