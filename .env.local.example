# ── AI Provider Configuration ────────────────────────────────────────────────
# Choose ONE active provider. The /api/ai route reads from env on each request.
# All values are server-side only — never exposed to the browser.

# Active provider: anthropic | openai | custom
AI_PROVIDER=anthropic

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (GPT-4o / o1 / o3) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Custom (OpenAI-compatible endpoint) ──────────────────────────────────────
# Works with: Ollama, Groq, Together AI, Azure OpenAI, LM Studio, vLLM, etc.
# CUSTOM_AI_KEY can be empty for local Ollama (no auth).
CUSTOM_AI_URL=http://localhost:11434
CUSTOM_AI_KEY=
CUSTOM_AI_MODEL=llama3.1

# Optional local MCP bridge. Prefer npm run dev:mcp / start:mcp (loopback only).
CHORONO_MCP_ENABLED=0
# CHORONO_MCP_PROJECT_DIR=/absolute/path/to/chorono-projects
