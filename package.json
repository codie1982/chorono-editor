{
  "name": "chorono-editor",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "next dev -p 2000",
    "build": "next build",
    "start": "next start -p 2000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:prepare": "node scripts/perf/prepare.mjs",
    "perf:serve": "node scripts/perf/serve.mjs",
    "build:runtime": "tsup",
    "dev:mcp": "CHORONO_MCP_ENABLED=1 next dev -H 127.0.0.1 -p 2000",
    "start:mcp": "CHORONO_MCP_ENABLED=1 next start -H 127.0.0.1 -p 2000",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:setup": "node scripts/setup-mcp.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "cli:test": "node --test packages/cli/test/*.test.mjs",
    "cli:pack": "node scripts/pack-cli.mjs",
    "skills": "node packages/cli/bin/chorono.mjs skills",
    "chorono": "node packages/cli/bin/chorono.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/opentype.js": "^1.3.9",
    "ajv": "^8.20.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.0.0",
    "next": "14.2.35",
    "opentype.js": "^2.0.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.28.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
