# MongoDB Connection (parametric - can be local or cloud)
# Default: local MongoDB on port 27017
# Cloud example: mongodb+srv://user:pass@cluster.mongodb.net/chorono
MONGODB_URI=mongodb://localhost:27017/chorono

# Keycloak Configuration
KEYCLOAK_REALM=chorono-local
KEYCLOAK_CLIENT_ID=chorono-app
KEYCLOAK_PUBLIC_KEY=your_public_key_here

# Git Backup Configuration
GIT_REPO_ROOT=./backups/scenes

# Node Environment
NODE_ENV=development
